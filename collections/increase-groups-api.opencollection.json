{
  "opencollection": "1.0.0",
  "info": {
    "name": "Increase Account Numbers Groups API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Group details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.increase.com/groups/current"
          },
          "docs": "Returns details for the currently authenticated Group."
        }
      ]
    }
  ],
  "bundled": true
}