    {
      "id": "24327f3b-9a78-42cb-8440-9b30482592ec",
      "name": "Wire Drawdown Requests",
      "description": {
        "content": "Wire drawdown requests enable you to request that someone else send you a wire. Because there is nuance to making sure your counterparty's bank processes these correctly, we ask that you reach out to [support@increase.com](mailto:support@increase.com) to enable this feature so we can help you plan your integration. For more information, see our [Wire Drawdown Requests documentation](/documentation/wire-drawdown-requests).",
        "type": "text/plain"
      },
