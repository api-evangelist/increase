    {
      "id": "c31391ac-8fe2-4d13-869d-da26a7084d31",
      "name": "Exports",
      "description": {
        "content": "Exports are generated files. Some exports can contain a lot of data, like a CSV of your transactions. Others can be a single document, like a tax form. Since they can take a while, they are generated asynchronously. We send a webhook when they are ready. For more information, please read our [Exports documentation](https://increase.com/documentation/exports).",
        "type": "text/plain"
      },
